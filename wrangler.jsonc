{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeppelin",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/live"],
  },
  "routes": [{ "pattern": "zeppelin.hexly.ai", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "dev": { "ip": "127.0.0.1", "port": 17052 },
}
