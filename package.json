{
  "name": "zeppelin",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/validate.mjs && vite build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "assets:verify": "node scripts/verify-cdn.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:check": "wrangler deploy --dry-run --outdir .local/worker-bundle",
    "verify:production": "node scripts/verify-deployment.mjs",
    "dev:worker": "wrangler dev --local --inspector-port 0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/three": "^0.187.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "wrangler": "^4.156.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "three": "0.187.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "source-map-js": "1.2.2"
  }
}
