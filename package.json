{
  "name": "zeppelin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/validate.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "assets:verify": "node scripts/verify-cdn.mjs",
    "test": "playwright test",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:check": "wrangler deploy --dry-run --outdir .local/worker-bundle",
    "verify:production": "node scripts/verify-deployment.mjs",
    "dev:worker": "wrangler dev --local --inspector-port 0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.5",
    "wrangler": "4.135.0"
  },
  "packageManager": "npm@11.19.0"
}
